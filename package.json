{
  "name": "pr1me-mapper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @mapper/api db:generate",
    "db:migrate": "pnpm --filter @mapper/api db:migrate",
    "ingest": "pnpm --filter @mapper/api ingest",
    "embed": "pnpm --filter @mapper/api embed",
    "match": "pnpm --filter @mapper/api match",
    "dev": "pnpm --parallel --filter @mapper/api --filter @mapper/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "site:build": "pnpm --filter @mapper/web build:static && pnpm --filter @mapper/api snapshot",
    "site:preview": "pnpm --filter @mapper/web preview:static",
    "site:publish": "wrangler pages deploy apps/web/dist-static --project-name pr1me-mapper --branch main"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
