{
  "name": "@mapper/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "ingest": "tsx --env-file=../../.env src/ingest/cli.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "embed": "tsx --env-file=../../.env src/matching/cli.ts embed",
    "match": "tsx --env-file=../../.env src/matching/cli.ts match"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^1.14.0",
    "@mapper/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "exceljs": "^4.4.0",
    "hono": "^4.8.0",
    "postgres": "^3.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
