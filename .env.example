# Postgres (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgres://mapper:mapper@localhost:5433/mapper

# API
API_PORT=3001

# Source files for `pnpm ingest` (relative to repo root)
SOURCE_DIR=data/source

# Embeddings: ollama (local) | openai (external API, needs OPENAI_API_KEY and consent)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_URL=http://localhost:11434

# LLM judge. Nothing is sent until a user agrees on the run page (or --consent on the CLI).
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-5-5
JUDGE_EFFORT=low
JUDGE_CONCURRENCY=4
